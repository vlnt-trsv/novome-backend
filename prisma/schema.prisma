generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth", "moderation", "file"]
}

model Auth {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ --- 
  id                         String    @id @default(uuid()) @db.Uuid
  type                       AUTH_TYPE @default(USER)
  email                      String    @unique
  phone                      String?   @unique
  // --- ПАРОЛИ И КЛЮЧИ ---
  hashedPassword             String
  hashedRt                   String?
  // --- ПОДТВЕРЖДЕНИЕ EMAIL ---
  confirmed                  Boolean   @default(false)
  emailConfirmedAt           DateTime?
  confirmationToken          String?   @unique
  confirmationTokenExpiresAt DateTime?
  confirmationSentAt         DateTime?
  // --- ВОССТАНОВЛЕНИЕ ДОСТУПА ---
  recoveryToken              String?   @unique
  recoveryTokenExpiresAt     DateTime?
  recoverySentAt             DateTime?
  // --- БЕЗОПАСНОСТЬ И АУДИТ ---
  lastSignInAt               DateTime?
  lastChangePasswordAt       DateTime?
  // --- СВЯЗИ (RELATIONS) ---
  user                       User?     @relation("UserAuth")
  staff                      Staff?    @relation("StaffAuth")

  @@map("auths")
  @@schema("auth")
}

model Staff {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ --- 
  id        String       @id @default(uuid()) @db.Uuid
  email     String       @unique
  fullName  String
  // --- СВЯЗИ (RELATIONS) ---
  moderated Moderation[]
  auth      Auth         @relation("StaffAuth", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("staffs")
  @@schema("moderation")
}

model User {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  phone        String?       @unique
  role         ROLE
  // --- ПРОФИЛЬ ---
  fullName     String
  avatar       String?
  language     String        @default("ru")
  timezone     String        @default("Asia/Novosibirsk")
  // --- МАРКЕТИНГ И КОММУНИКАЦИИ ---
  leadSource   String? // Откуда пришел пользователь (для аналитики)
  // consents   Consents
  // --- СЛУЖЕБНЫЕ ПОЛЯ ---
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  // --- СВЯЗИ (RELATIONS) ---
  userConsents UserConsent[]
  moderation   Moderation?
  tickets      Ticket[]
  patient      Patient?      @relation("Patient")
  doctor       Doctor?       @relation("Doctor")
  clinic       Clinic?       @relation("Clinic")
  auth         Auth          @relation("UserAuth", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  // --- ЭКОСИСТЕМА И БАЛАНС ---
  aiToken      Int           @default(10)

  @@index([email, phone])
  @@map("users")
  @@schema("public")
}

model Patient {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
  id                     String                  @unique @db.Uuid
  // --- ЛИЧНЫЕ И ДЕМОГРАФИЧЕСКИЕ ДАННЫЕ ---
  birthdate              DateTime?
  gender                 GENDER?
  // --- МЕДИЦИНСКИЙ ПРОФИЛЬ (Анамнез) ---
  medicalNotes           String?                 @db.Text
  bloodType              String? // Например: "A+", "B-"
  allergies              String[]                @default([])
  chronicDiseases        String?                 @db.Text
  // --- СЛУЖЕБНЫЕ ПОЛЯ ---
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  // --- СВЯЗИ (RELATIONS) ---
  patientFavoriteDoctors PatientFavoriteDoctor[]
  patientFavoriteClinics PatientFavoriteClinic[]
  // appointments        Appointment[]           
  documents              Document[]
  // reviews             Review[]                
  user                   User                    @relation("Patient", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("patients")
  @@schema("public")
}

model Doctor {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
  id                 String                  @unique @db.Uuid
  clinicId           String?                 @db.Uuid
  // --- ЛИЧНЫЕ И ДЕМОГРАФИЧЕСКИЕ ДАННЫЕ ---
  gender             GENDER?
  birthdate          DateTime?
  // --- ПРОФЕССИОНАЛЬНЫЙ БЛОК ---
  experience         Int
  specializations    SPECIALIZATION[]
  education          String
  workplace          String?
  // --- ПОЛЯ ДЛЯ HIGHLOAD, ПОИСКА И SEO ---
  bio                String?                 @db.Text
  // TODO: сначала создать сервис rating - rating Float @default(0.0) (кэшированное значение, чтобы не считайть каждый раз по 1000 отзывов) 
  // reviewsCount       Int @default(0)
  // --- БИЗНЕС-ЛОГИКА И СТАТУСЫ ---
  isActive           Boolean                 @default(true) // Работает ли врач в системе
  isSearchable       Boolean                 @default(true) // Виден ли в поиске (скрываем, если в отпуске)
  // consultationDuration Int                     @default(30)
  // --- ЮРИДИЧЕСКИЙ БЛОК ---
  inn                String                  @unique
  license            String                  @unique
  // --- СЛУЖЕБНЫЕ ПОЛЯ ---
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  // --- СВЯЗИ (RELATIONS) ---
  documents          Document[]
  favoriteByPatients PatientFavoriteDoctor[]
  // appointments    Appointment[]
  // services        Service[]
  // slots           Slot[]
  user               User                    @relation("Doctor", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  clinic             Clinic?                 @relation(fields: [clinicId], references: [id])

  @@map("doctors")
  @@schema("public")
}

model Clinic {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
  id                 String                  @unique @db.Uuid
  // --- ЮРИДИЧЕСКИЙ БЛОК ---
  legalName          String
  brandName          String?
  inn                String                  @unique
  ogrn               String
  license            String
  directorName       String
  directorPosition   String
  // --- ГЕОПОЗИЦИОНИРОВАНИЕ И КОНТАКТЫ ---
  legalAddress       String
  actualAddress      String
  city               String?
  phone              String?
  website            String?
  // --- ПОЛЯ ДЛЯ HIGHLOAD И МАРКЕТИНГА ---
  description        String?                 @db.Text
  // rating             Float                   @default(0.0)
  // reviewsCount       Int                     @default(0)
  // --- БИЗНЕС-ЛОГИКА И СТАТУСЫ ---
  isActive           Boolean                 @default(true)
  // workTime           Json? //  (например: { "mon": "09:00-21:00", ... })
  // --- СЛУЖЕБНЫЕ ПОЛЯ ---
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  // --- СВЯЗИ (RELATIONS) ---
  favoriteByPatients PatientFavoriteClinic[]
  // services        Service[]
  documents          Document[]
  doctors            Doctor[]
  user               User                    @relation("Clinic", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([city])
  @@map("clinics")
  @@schema("public")
}

model Moderation {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @unique @db.Uuid
  moderatorId String?           @db.Uuid
  status      MODERATION_STATUS @default(PENDING)
  comment     String?           @db.Text
  // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  // --- СВЯЗИ (RELATIONS) ---
  tickets     Ticket[]
  user        User              @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  moderator   Staff?            @relation(fields: [moderatorId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("moderations")
  @@schema("moderation")
}

model Ticket {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  moderationId String?         @db.Uuid
  subject      String
  status       TICKET_STATUS   @default(OPEN)
  messages     TicketMessage[]
  // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  // --- СВЯЗИ (RELATIONS) ---
  user         User            @relation(fields: [userId], references: [id])
  moderation   Moderation?     @relation(fields: [moderationId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("tickets")
  @@schema("moderation")
}

model TicketMessage {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  senderId   String   @db.Uuid
  text       String   @db.Text
  isInternal Boolean  @default(false)
  // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
  createdAt  DateTime @default(now())
  // --- СВЯЗИ (RELATIONS) ---
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("ticket_messages")
  @@schema("moderation")
}

model Document {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
  id        String   @unique @db.Uuid
  // type      DOCUMENT_TYPE
  patientId String?  @db.Uuid
  doctorId  String?  @db.Uuid
  clinicId  String?  @db.Uuid
  // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // --- СВЯЗИ (RELATIONS) ---
  patient   Patient? @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  doctor    Doctor?  @relation(fields: [doctorId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  clinic    Clinic?  @relation(fields: [clinicId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  file      File     @relation("Documents", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("documents")
  @@schema("public")
}

model File {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
  id           String    @id @default(uuid()) @db.Uuid
  originalName String
  mimeType     String
  size         Int
  s3Key        String    @unique
  url          String
  // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
  createdAt    DateTime  @default(now())
  // --- СВЯЗИ (RELATIONS) ---
  documents    Document? @relation("Documents")

  @@map("files")
  @@schema("file")
}

model PatientFavoriteDoctor {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  doctorId String   @db.Uuid
  addedAt  DateTime @default(now())
  patient  Patient  @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  doctor   Doctor   @relation(fields: [doctorId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([userId, doctorId])
  @@index([userId])
  @@index([doctorId])
  @@map("patient_favorite_doctors")
  @@schema("public")
}

model PatientFavoriteClinic {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  clinicId String   @db.Uuid
  addedAt  DateTime @default(now())
  patient  Patient  @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([userId, clinicId])
  @@index([userId])
  @@index([clinicId])
  @@map("patient_favorite_clinics")
  @@schema("public")
}

model Consent {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
  id           String        @id @default(uuid()) @db.Uuid
  type         CONSENT_TYPE
  version      String
  title        String
  text         String        @db.Text
  isRequired   Boolean       @default(true)
  isPublished  Boolean       @default(false)
  // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
  createdAt    DateTime      @default(now())
  // --- СВЯЗИ (RELATIONS) ---
  userConsents UserConsent[]

  @@unique([type, version])
  @@map("consents")
  @@schema("moderation")
}

model UserConsent {
  // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  consentId String   @db.Uuid
  ipAddress String?
  userAgent String?
  // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
  signedAt  DateTime @default(now())
  // --- СВЯЗИ (RELATIONS) ---
  user      User     @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  consent   Consent? @relation(fields: [consentId], references: [id])

  @@map("user_consents")
  @@schema("public")
}

enum CONSENT_TYPE {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MEDICAL_DATA_PROCESSING
  MARKETING

  @@schema("moderation")
}

enum AUTH_TYPE {
  USER
  STAFF

  @@schema("auth")
}

enum ROLE {
  PATIENT
  DOCTOR
  CLINIC

  @@schema("public")
}

enum MODERATION_STATUS {
  PENDING
  APPROVED
  REJECTED
  BANNED

  @@schema("moderation")
}

enum TICKET_STATUS {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@schema("moderation")
}

enum GENDER {
  MALE
  FEMALE

  @@schema("public")
}

// enum DOCUMENT_TYPE {
//   LICENSE
//   DIPLOMA
//   CERTIFICATE
//   PASSPORT
//   OTHER

//   @@schema("public")
// }

enum SPECIALIZATION {
  // Эстетическая хирургия лица
  RHINOPLASTY // Ринопластика (пластика носа)
  BLEPHAROPLASTY // Блефаропластика (пластика век)
  FACELIFT // Фейслифтинг (подтяжка лица)
  FOREHEAD_LIFT // Подтяжка лба
  CHEEK_AUGMENTATION // Увеличение скул
  CHIN_AUGMENTATION // Увеличение подбородка
  OTOPLASTY // Отопластика (пластика ушей)
  LIP_AUGMENTATION // Увеличение губ
  NECK_LIFT // Подтяжка шеи

  // Эстетическая хирургия тела
  MAMMOPLASTY // Маммопластика (пластика груди)
  BREAST_AUGMENTATION // Увеличение груди
  BREAST_REDUCTION // Уменьшение груди
  BREAST_LIFT // Подтяжка груди
  LIPOSUCTION // Липосакция
  ABDOMINOPLASTY // Абдоминопластика (пластика живота)
  BUTTOCK_AUGMENTATION // Увеличение ягодиц
  BUTTOCK_LIFT // Подтяжка ягодиц
  THIGH_LIFT // Подтяжка бедер
  ARM_LIFT // Подтяжка рук

  // Реконструктивная хирургия
  BURN_RECONSTRUCTION // Реконструкция после ожогов
  TRAUMA_RECONSTRUCTION // Реконструкция после травм
  CANCER_RECONSTRUCTION // Реконструкция после онкологии
  CLEFT_LIP_PALATE // Расщелина губы и неба
  CONGENITAL_DEFORMITIES // Врожденные деформации

  // Микрохирургия
  MICROSURGERY // Микрохирургия
  TISSUE_TRANSPLANTATION // Пересадка тканей
  FLAP_SURGERY // Хирургия лоскутов

  // Хирургия кисти
  HAND_SURGERY // Хирургия кисти
  HAND_RECONSTRUCTION // Реконструкция кисти
  TENDON_REPAIR // Восстановление сухожилий

  // Челюстно-лицевая хирургия
  MAXILLOFACIAL_SURGERY // Челюстно-лицевая хирургия
  JAW_CORRECTION // Коррекция челюсти
  FACIAL_FRACTURE // Переломы лица

  // Дерматология и косметология
  DERMABRASION // Дермабразия
  CHEMICAL_PEEL // Химический пилинг
  LASER_SURGERY // Лазерная хирургия
  SCAR_REVISION // Коррекция рубцов

  // Генитальная пластическая хирургия
  LABIAPLASTY // Лабиопластика
  VAGINOPLASTY // Вагинопластика
  PENILE_AUGMENTATION // Увеличение полового члена

  // Общая пластическая хирургия
  GENERAL_PLASTIC_SURGERY // Общая пластическая хирургия
  COSMETIC_SURGERY // Косметическая хирургия
  RECONSTRUCTIVE_SURGERY // Реконструктивная хирургия

  @@schema("public")
}
