generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

model Auth {
  userId                     String    @unique @db.Uuid
  user                       User      @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  hashedPassword             String
  email                      String    @unique
  emailConfirmedAt           DateTime?
  confirmationSentAt         DateTime?
  confirmationToken          String?   @unique
  confirmationTokenExpiresAt DateTime?
  lastSignInAt               DateTime?
  confirmed                  Boolean   @default(false)
  phone                      String?
  hashedRt                   String?

  @@map("auth")
  @@schema("auth")
}

model User {
  id         String      @id @default(uuid()) @db.Uuid
  patient    Patient?
  doctor     Doctor?
  clinic     Clinic?
  moderation Moderation?
  auth       Auth?
  // 
  role       ROLE
  fullName   String
  email      String      @unique
  phone      String?
  aiToken    Int         @default(10)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("users")
  @@schema("public")
}

model Patient {
  userId                 String                  @unique @db.Uuid
  user                   User                    @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  //
  birthdate              DateTime?
  gender                 GENDER?
  documents              Document[]
  patientFavoriteDoctors PatientFavoriteDoctor[]
  patientFavoriteClinics PatientFavoriteClinic[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@map("patients")
  @@schema("public")
}

model Doctor {
  userId             String                  @unique @db.Uuid
  clinicId           String?                 @db.Uuid
  user               User                    @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  clinic             Clinic?                 @relation(fields: [clinicId], references: [userId])
  // 
  gender             GENDER?
  birthdate          DateTime?
  licenseNumber      String
  specialization     SPECIALIZATION
  experience         Int
  education          String
  workplace          String?
  inn                String
  documents          Document[]
  favoriteByPatients PatientFavoriteDoctor[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@map("doctors")
  @@schema("public")
}

model Clinic {
  userId             String                  @unique @db.Uuid
  user               User                    @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  // 
  legalName          String
  legalAddress       String
  actualAddress      String
  clinicLicense      String
  directorName       String
  directorPosition   String
  inn                String
  orgn               String
  documents          Document[]
  doctors            Doctor[]
  favoriteByPatients PatientFavoriteClinic[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@map("clinics")
  @@schema("public")
}

model Moderation {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @unique @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  // 
  status      MODERATION_STATUS @default(PENDING)
  comment     String?
  moderatedAt DateTime          @default(now())

  @@map("moderations")
  @@schema("public")
}

model Document {
  id            String        @id @default(uuid()) @db.Uuid
  patientUserId String?       @db.Uuid
  doctorUserId  String?       @db.Uuid
  clinicUserId  String?       @db.Uuid
  patient       Patient?      @relation(fields: [patientUserId], references: [userId], onUpdate: Cascade, onDelete: Cascade)
  doctor        Doctor?       @relation(fields: [doctorUserId], references: [userId], onUpdate: Cascade, onDelete: Cascade)
  clinic        Clinic?       @relation(fields: [clinicUserId], references: [userId], onUpdate: Cascade, onDelete: Cascade)
  // 
  type          DOCUMENT_TYPE
  url           String
  mimeType      String?
  size          Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("documents")
  @@schema("public")
}

model PatientFavoriteDoctor {
  id            String   @id @default(uuid()) @db.Uuid
  patientUserId String   @db.Uuid
  doctorUserId  String   @db.Uuid
  patient       Patient  @relation(fields: [patientUserId], references: [userId], onUpdate: Cascade, onDelete: Cascade)
  doctor        Doctor   @relation(fields: [doctorUserId], references: [userId], onUpdate: Cascade, onDelete: Cascade)
  addedAt       DateTime @default(now())

  @@unique([patientUserId, doctorUserId])
  @@index([patientUserId])
  @@index([doctorUserId])
  @@map("patient_favorite_doctors")
  @@schema("public")
}

model PatientFavoriteClinic {
  id            String   @id @default(uuid()) @db.Uuid
  patientUserId String   @db.Uuid
  clinicUserId  String   @db.Uuid
  patient       Patient  @relation(fields: [patientUserId], references: [userId], onUpdate: Cascade, onDelete: Cascade)
  clinic        Clinic   @relation(fields: [clinicUserId], references: [userId], onUpdate: Cascade, onDelete: Cascade)
  addedAt       DateTime @default(now())

  @@unique([patientUserId, clinicUserId])
  @@index([patientUserId])
  @@index([clinicUserId])
  @@map("patient_favorite_clinics")
  @@schema("public")
}

enum ROLE {
  PATIENT
  DOCTOR
  CLINIC

  @@schema("public")
}

enum MODERATION_STATUS {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}

enum GENDER {
  MALE
  FEMALE

  @@schema("public")
}

enum DOCUMENT_TYPE {
  LICENSE
  DIPLOMA
  CERTIFICATE
  PASSPORT
  OTHER

  @@schema("public")
}

enum SPECIALIZATION {
  // Эстетическая хирургия лица
  RHINOPLASTY // Ринопластика (пластика носа)
  BLEPHAROPLASTY // Блефаропластика (пластика век)
  FACELIFT // Фейслифтинг (подтяжка лица)
  FOREHEAD_LIFT // Подтяжка лба
  CHEEK_AUGMENTATION // Увеличение скул
  CHIN_AUGMENTATION // Увеличение подбородка
  OTOPLASTY // Отопластика (пластика ушей)
  LIP_AUGMENTATION // Увеличение губ
  NECK_LIFT // Подтяжка шеи

  // Эстетическая хирургия тела
  MAMMOPLASTY // Маммопластика (пластика груди)
  BREAST_AUGMENTATION // Увеличение груди
  BREAST_REDUCTION // Уменьшение груди
  BREAST_LIFT // Подтяжка груди
  LIPOSUCTION // Липосакция
  ABDOMINOPLASTY // Абдоминопластика (пластика живота)
  BUTTOCK_AUGMENTATION // Увеличение ягодиц
  BUTTOCK_LIFT // Подтяжка ягодиц
  THIGH_LIFT // Подтяжка бедер
  ARM_LIFT // Подтяжка рук

  // Реконструктивная хирургия
  BURN_RECONSTRUCTION // Реконструкция после ожогов
  TRAUMA_RECONSTRUCTION // Реконструкция после травм
  CANCER_RECONSTRUCTION // Реконструкция после онкологии
  CLEFT_LIP_PALATE // Расщелина губы и неба
  CONGENITAL_DEFORMITIES // Врожденные деформации

  // Микрохирургия
  MICROSURGERY // Микрохирургия
  TISSUE_TRANSPLANTATION // Пересадка тканей
  FLAP_SURGERY // Хирургия лоскутов

  // Хирургия кисти
  HAND_SURGERY // Хирургия кисти
  HAND_RECONSTRUCTION // Реконструкция кисти
  TENDON_REPAIR // Восстановление сухожилий

  // Челюстно-лицевая хирургия
  MAXILLOFACIAL_SURGERY // Челюстно-лицевая хирургия
  JAW_CORRECTION // Коррекция челюсти
  FACIAL_FRACTURE // Переломы лица

  // Дерматология и косметология
  DERMABRASION // Дермабразия
  CHEMICAL_PEEL // Химический пилинг
  LASER_SURGERY // Лазерная хирургия
  SCAR_REVISION // Коррекция рубцов

  // Генитальная пластическая хирургия
  LABIAPLASTY // Лабиопластика
  VAGINOPLASTY // Вагинопластика
  PENILE_AUGMENTATION // Увеличение полового члена

  // Общая пластическая хирургия
  GENERAL_PLASTIC_SURGERY // Общая пластическая хирургия
  COSMETIC_SURGERY // Косметическая хирургия
  RECONSTRUCTIVE_SURGERY // Реконструктивная хирургия

  @@schema("public")
}
