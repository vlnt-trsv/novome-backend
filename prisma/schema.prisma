enum SPECIALIZATION {
  // Эстетическая хирургия лица
  RHINOPLASTY // Ринопластика (пластика носа)
  BLEPHAROPLASTY // Блефаропластика (пластика век)
  FACELIFT // Фейслифтинг (подтяжка лица)
  FOREHEAD_LIFT // Подтяжка лба
  CHEEK_AUGMENTATION // Увеличение скул
  CHIN_AUGMENTATION // Увеличение подбородка
  OTOPLASTY // Отопластика (пластика ушей)
  LIP_AUGMENTATION // Увеличение губ
  NECK_LIFT // Подтяжка шеи

  // Эстетическая хирургия тела
  MAMMOPLASTY // Маммопластика (пластика груди)
  BREAST_AUGMENTATION // Увеличение груди
  BREAST_REDUCTION // Уменьшение груди
  BREAST_LIFT // Подтяжка груди
  LIPOSUCTION // Липосакция
  ABDOMINOPLASTY // Абдоминопластика (пластика живота)
  BUTTOCK_AUGMENTATION // Увеличение ягодиц
  BUTTOCK_LIFT // Подтяжка ягодиц
  THIGH_LIFT // Подтяжка бедер
  ARM_LIFT // Подтяжка рук

  // Реконструктивная хирургия
  BURN_RECONSTRUCTION // Реконструкция после ожогов
  TRAUMA_RECONSTRUCTION // Реконструкция после травм
  CANCER_RECONSTRUCTION // Реконструкция после онкологии
  CLEFT_LIP_PALATE // Расщелина губы и неба
  CONGENITAL_DEFORMITIES // Врожденные деформации

  // Микрохирургия
  MICROSURGERY // Микрохирургия
  TISSUE_TRANSPLANTATION // Пересадка тканей
  FLAP_SURGERY // Хирургия лоскутов

  // Хирургия кисти
  HAND_SURGERY // Хирургия кисти
  HAND_RECONSTRUCTION // Реконструкция кисти
  TENDON_REPAIR // Восстановление сухожилий

  // Челюстно-лицевая хирургия
  MAXILLOFACIAL_SURGERY // Челюстно-лицевая хирургия
  JAW_CORRECTION // Коррекция челюсти
  FACIAL_FRACTURE // Переломы лица

  // Дерматология и косметология
  DERMABRASION // Дермабразия
  CHEMICAL_PEEL // Химический пилинг
  LASER_SURGERY // Лазерная хирургия
  SCAR_REVISION // Коррекция рубцов

  // Генитальная пластическая хирургия
  LABIAPLASTY // Лабиопластика
  VAGINOPLASTY // Вагинопластика
  PENILE_AUGMENTATION // Увеличение полового члена

  // Общая пластическая хирургия
  GENERAL_PLASTIC_SURGERY // Общая пластическая хирургия
  COSMETIC_SURGERY // Косметическая хирургия
  RECONSTRUCTIVE_SURGERY // Реконструктивная хирургия

  @@schema("public")
}
