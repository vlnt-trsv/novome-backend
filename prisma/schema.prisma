generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth", "moderation", "file"]
}

model Auth {
  id                         String    @id @default(uuid()) @db.Uuid
  type                       AUTH_TYPE @default(USER)
  email                      String    @unique
  emailConfirmedAt           DateTime?
  confirmationSentAt         DateTime?
  confirmationToken          String?   @unique
  confirmationTokenExpiresAt DateTime?
  lastSignInAt               DateTime?
  confirmed                  Boolean   @default(false)
  phone                      String?
  hashedPassword             String
  lastChangePasswordAt       DateTime?
  recoverySentAt             DateTime?
  recoveryToken              String?
  recoveryTokenExpiresAt     DateTime?
  hashedRt                   String?
  user                       User?     @relation("UserAuth")
  staff                      Staff?    @relation("StaffAuth")

  @@map("auths")
  @@schema("auth")
}

model Staff {
  id        String       @id @default(uuid()) @db.Uuid
  email     String       @unique
  fullName  String
  moderated Moderation[]
  auth      Auth         @relation("StaffAuth", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("staffs")
  @@schema("moderation")
}

model User {
  id         String      @id @default(uuid()) @db.Uuid
  patient    Patient?    @relation("Patient")
  doctor     Doctor?     @relation("Doctor")
  clinic     Clinic?     @relation("Clinic")
  moderation Moderation?
  role       ROLE
  fullName   String
  avatar     String?
  email      String      @unique
  phone      String?
  aiToken    Int         @default(10)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  auth       Auth        @relation("UserAuth", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("users")
  @@schema("public")
}

model Patient {
  id                     String                  @unique @db.Uuid
  user                   User                    @relation("Patient", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  birthdate              DateTime?
  gender                 GENDER?
  documents              Document[]
  patientFavoriteDoctors PatientFavoriteDoctor[]
  patientFavoriteClinics PatientFavoriteClinic[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@map("patients")
  @@schema("public")
}

model Doctor {
  id                 String                  @unique @db.Uuid
  clinicId           String?                 @db.Uuid
  user               User                    @relation("Doctor", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  clinic             Clinic?                 @relation(fields: [clinicId], references: [id])
  gender             GENDER?
  birthdate          DateTime?
  license            String                  @unique
  specialization     SPECIALIZATION
  experience         Int
  education          String
  workplace          String?
  inn                String                  @unique
  documents          Document[]
  favoriteByPatients PatientFavoriteDoctor[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@map("doctors")
  @@schema("public")
}

model Clinic {
  id                 String                  @unique @db.Uuid
  user               User                    @relation("Clinic", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  // 
  legalName          String
  legalAddress       String
  actualAddress      String
  license            String
  directorName       String
  directorPosition   String
  inn                String                  @unique
  ogrn               String
  documents          Document[]
  doctors            Doctor[]
  favoriteByPatients PatientFavoriteClinic[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@map("clinics")
  @@schema("public")
}

model Moderation {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @unique @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  moderatorId String?     @db.Uuid
  moderator   Staff?      @relation(fields: [moderatorId], references: [id])
  // 
  status      USER_STATUS @default(PENDING)
  comment     String?
  tickets     Ticket[]
  moderatedAt DateTime    @default(now())

  @@map("moderations")
  @@schema("moderation")
}

model Ticket {
  id           String        @id @default(uuid()) @db.Uuid
  subject      String
  description  String
  status       TICKET_STATUS @default(OPEN)
  createdAt    DateTime      @default(now())
  moderationId String?       @db.Uuid
  moderation   Moderation?   @relation(fields: [moderationId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("tickets")
  @@schema("moderation")
}

model Document {
  id        String   @unique @db.Uuid
  // type      DOCUMENT_TYPE
  patientId String?  @db.Uuid
  doctorId  String?  @db.Uuid
  clinicId  String?  @db.Uuid
  patient   Patient? @relation(fields: [patientId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  doctor    Doctor?  @relation(fields: [doctorId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  clinic    Clinic?  @relation(fields: [clinicId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  file      File     @relation("Documents", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
  @@schema("public")
}

model File {
  id           String    @id @default(uuid()) @db.Uuid
  originalName String
  mimeType     String
  size         Int
  s3Key        String    @unique
  url          String
  documents    Document? @relation("Documents")
  createdAt    DateTime  @default(now())

  @@map("files")
  @@schema("file")
}

model PatientFavoriteDoctor {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  doctorId String   @db.Uuid
  patient  Patient  @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  doctor   Doctor   @relation(fields: [doctorId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@unique([userId, doctorId])
  @@index([userId])
  @@index([doctorId])
  @@map("patient_favorite_doctors")
  @@schema("public")
}

model PatientFavoriteClinic {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  clinicId String   @db.Uuid
  patient  Patient  @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  addedAt  DateTime @default(now())

  @@unique([userId, clinicId])
  @@index([userId])
  @@index([clinicId])
  @@map("patient_favorite_clinics")
  @@schema("public")
}

enum AUTH_TYPE {
  USER
  STAFF

  @@schema("auth")
}

enum ROLE {
  PATIENT
  DOCTOR
  CLINIC

  @@schema("public")
}

enum USER_STATUS {
  PENDING
  APPROVED
  REJECTED
  BANNED

  @@schema("moderation")
}

enum TICKET_STATUS {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@schema("moderation")
}

enum GENDER {
  MALE
  FEMALE

  @@schema("public")
}

