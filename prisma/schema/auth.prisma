model Auth {
    id                         String    @id @default(uuid()) @db.Uuid
    type                       AUTH_TYPE @default(USER)
    email                      String    @unique
    phone                      String?   @unique
    hashedPassword             String
    hashedRt                   String?
    confirmed                  Boolean   @default(false)
    emailConfirmedAt           DateTime?
    confirmationToken          String?   @unique
    confirmationTokenExpiresAt DateTime?
    confirmationSentAt         DateTime?
    recoveryToken              String?   @unique
    recoveryTokenExpiresAt     DateTime?
    recoverySentAt             DateTime?
    lastSignInAt               DateTime?
    lastChangePasswordAt       DateTime?
    user                       User?     @relation("UserAuth")
    staff                      Staff?    @relation("StaffAuth")

    @@map("auths")
    @@schema("auth")
}

enum AUTH_TYPE {
    USER
    STAFF

    @@schema("auth")
}
