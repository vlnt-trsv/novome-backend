// model Appointment {}

model Schedule {
    id           String  @id @default(uuid()) @db.Uuid
    doctorId     String? @db.Uuid
    clinicId     String? @db.Uuid
    dayOfWeek    Int
    startAt      String
    endAt        String
    slotDuration Int     @default(30)
    doctor       Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    clinic       Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("shedules")
    @@schema("booking")
}

model Break {
    id       String     @id @default(uuid()) @db.Uuid
    doctorId String     @db.Uuid
    type     BREAK_TYPE @default(VACATION)
    startAt  DateTime?
    endAt    DateTime?
    doctor   Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("breaks")
    @@schema("booking")
}

model WorkRule {
    id        String    @id @default(uuid()) @db.Uuid
    doctorId  String    @db.Uuid
    type      RULE_TYPE @default(LUNCH)
    startTime String
    endTime   String
    doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("work_rules")
    @@schema("booking")
}

model TimeSlot {
    id        String      @id @default(uuid()) @db.Uuid
    doctorId  String?     @db.Uuid
    clinicId  String?     @db.Uuid
    startAt   DateTime
    endAt     DateTime
    status    SLOT_STATUS @default(AVAILABLE)
    // appointmentId String? @unique @db.Uuid
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
    doctor    Doctor?     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
    clinic    Clinic?     @relation(fields: [clinicId], references: [id], onDelete: Cascade)

    @@index([doctorId, startAt])
    @@index([clinicId, startAt])
    @@map("time_slots")
    @@schema("booking")
}

enum BREAK_TYPE {
    VACATION
    SICK_LEAVE
    OTHER

    @@schema("booking")
}

enum RULE_TYPE {
    LUNCH

    @@schema("booking")
}

enum SLOT_STATUS {
    AVAILABLE
    BOOKED
    LOCKED
    CANCELED

    @@schema("booking")
}
