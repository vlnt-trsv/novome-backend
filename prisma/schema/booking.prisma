model Appointment {
    id         String             @id @default(uuid()) @db.Uuid
    patientId  String             @db.Uuid
    doctorId   String             @db.Uuid
    clinicId   String?            @db.Uuid
    timeSlotId String             @unique @db.Uuid
    status     APPOINTMENT_STATUS @default(PENDING)
    type       APPOINTMENT_TYPE   @default(OFFLINE)
    reason     String?            @db.Text // причина обращения
    notes      String?            @db.Text // заметки врача
    createdAt  DateTime           @default(now())
    updatedAt  DateTime           @updatedAt
    serviceIds String[]           @db.Uuid
    patient    Patient            @relation(fields: [patientId], references: [id])
    doctor     Doctor             @relation(fields: [doctorId], references: [id])
    clinic     Clinic?            @relation(fields: [clinicId], references: [id])
    timeSlot   TimeSlot           @relation(fields: [timeSlotId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("appointments")
    @@schema("booking")
}

model Schedule {
    id           String  @id @default(uuid()) @db.Uuid
    doctorId     String? @db.Uuid
    clinicId     String? @db.Uuid
    dayOfWeek    Int
    startAt      String
    endAt        String
    slotDuration Int     @default(30)
    doctor       Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    clinic       Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("shedules")
    @@schema("booking")
}

model Break {
    id       String     @id @default(uuid()) @db.Uuid
    doctorId String     @db.Uuid
    type     BREAK_TYPE @default(VACATION)
    startAt  DateTime?
    endAt    DateTime?
    doctor   Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("breaks")
    @@schema("booking")
}

model WorkRule {
    id        String    @id @default(uuid()) @db.Uuid
    doctorId  String    @db.Uuid
    type      RULE_TYPE @default(LUNCH)
    startTime String
    endTime   String
    doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("work_rules")
    @@schema("booking")
}

model TimeSlot {
    id          String       @id @default(uuid()) @db.Uuid
    doctorId    String?      @db.Uuid
    clinicId    String?      @db.Uuid
    startAt     DateTime
    endAt       DateTime
    status      SLOT_STATUS  @default(AVAILABLE)
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    doctor      Doctor?      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
    clinic      Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
    appointment Appointment?

    @@index([doctorId, startAt])
    @@index([clinicId, startAt])
    @@map("time_slots")
    @@schema("booking")
}

enum APPOINTMENT_STATUS {
    PENDING // ожидание 
    CONFIRMED // подтвержден
    COMPLETED // завершен (доктор провел приём)
    CANCELED // отменен
    NO_SHOW // пациент не пришёл

    @@schema("booking")
}

enum APPOINTMENT_TYPE {
    OFFLINE
    ONLINE
    HOME_VISIT

    @@schema("booking")
}

enum BREAK_TYPE {
    VACATION
    SICK_LEAVE
    OTHER

    @@schema("booking")
}

enum RULE_TYPE {
    LUNCH

    @@schema("booking")
}

enum SLOT_STATUS {
    AVAILABLE
    BOOKED
    LOCKED
    CANCELED

    @@schema("booking")
}
