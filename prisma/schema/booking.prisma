// model Appointment {}

model Schedule {
    id           String  @id @default(uuid()) @db.Uuid
    doctorId     String? @db.Uuid
    clinicId     String? @db.Uuid
    dayOfWeek    Int
    startAt      String
    endAt        String
    slotDuration Int     @default(30)
    doctor       Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    clinic       Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("shedules")
    @@schema("booking")
}

model Break {
    id          String     @id @default(uuid()) @db.Uuid
    doctorId    String     @db.Uuid
    type        BREAK_TYPE @default(LUNCH)
    startAt     DateTime?
    endAt       DateTime?
    startTime   String?
    endTime     String?
    isRecurring Boolean    @default(false)
    doctor      Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@map("breaks")
    @@schema("booking")
}

model TimeSlot {
    id        String      @id @default(uuid()) @db.Uuid
    doctorId  String?     @db.Uuid
    clinicId  String?     @db.Uuid
    startAt   DateTime
    endAt     DateTime
    status    SLOT_STATUS @default(AVAILABLE)
    // appointmentId String? @unique @db.Uuid
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
    doctor    Doctor?     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
    clinic    Clinic?     @relation(fields: [clinicId], references: [id], onDelete: Cascade)

    @@index([doctorId, startAt])
    @@index([clinicId, startAt])
    @@map("time_slots")
    @@schema("booking")
}

enum BREAK_TYPE {
    LUNCH
    VACATION
    SICK_LEAVE
    OTHER

    @@schema("booking")
}

enum SLOT_STATUS {
    AVAILABLE
    BOOKED
    LOCKED
    CANCELED

    @@schema("booking")
}

enum DAY_OF_WEEK {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY

    @@schema("booking")
}
