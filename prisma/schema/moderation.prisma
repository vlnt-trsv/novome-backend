model Staff {
    // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ --- 
    id        String       @id @default(uuid()) @db.Uuid
    email     String       @unique
    fullName  String
    // --- СВЯЗИ (RELATIONS) ---
    moderated Moderation[]
    auth      Auth         @relation("StaffAuth", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)

    @@map("staffs")
    @@schema("moderation")
}

model Moderation {
    // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
    id          String            @id @default(uuid()) @db.Uuid
    userId      String            @unique @db.Uuid
    moderatorId String?           @db.Uuid
    status      MODERATION_STATUS @default(APPROVED)
    comment     String?           @db.Text
    // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt
    // --- СВЯЗИ (RELATIONS) ---
    tickets     Ticket[]
    user        User              @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
    moderator   Staff?            @relation(fields: [moderatorId], references: [id])

    @@index([userId])
    @@index([status])
    @@map("moderations")
    @@schema("moderation")
}

model Ticket {
    // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
    id           String          @id @default(uuid()) @db.Uuid
    userId       String          @db.Uuid
    moderationId String?         @db.Uuid
    subject      String
    status       TICKET_STATUS   @default(OPEN)
    messages     TicketMessage[]
    // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
    createdAt    DateTime        @default(now())
    updatedAt    DateTime        @updatedAt
    // --- СВЯЗИ (RELATIONS) ---
    user         User            @relation(fields: [userId], references: [id])
    moderation   Moderation?     @relation(fields: [moderationId], references: [id], onUpdate: Cascade, onDelete: Cascade)

    @@map("tickets")
    @@schema("moderation")
}

model TicketMessage {
    // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
    id         String   @id @default(uuid()) @db.Uuid
    ticketId   String   @db.Uuid
    senderId   String   @db.Uuid
    text       String   @db.Text
    isInternal Boolean  @default(false)
    // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
    createdAt  DateTime @default(now())
    // --- СВЯЗИ (RELATIONS) ---
    ticket     Ticket   @relation(fields: [ticketId], references: [id], onUpdate: Cascade, onDelete: Cascade)

    @@map("ticket_messages")
    @@schema("moderation")
}

model Consent {
    // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
    id           String        @id @default(uuid()) @db.Uuid
    type         CONSENT_TYPE
    version      String
    title        String
    text         String        @db.Text
    isRequired   Boolean       @default(true)
    isPublished  Boolean       @default(false)
    // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
    createdAt    DateTime      @default(now())
    // --- СВЯЗИ (RELATIONS) ---
    userConsents UserConsent[]

    @@unique([type, version])
    @@map("consents")
    @@schema("moderation")
}

model UserConsent {
    // --- СИСТЕМНЫЕ ИДЕНТИФИКАТОРЫ ---
    id        String   @id @default(uuid()) @db.Uuid
    userId    String   @db.Uuid
    consentId String   @db.Uuid
    ipAddress String?
    userAgent String?
    // --- СЛУЖЕБНЫЕ ПОЛЯ --- 
    signedAt  DateTime @default(now())
    // --- СВЯЗИ (RELATIONS) ---
    user      User     @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
    consent   Consent? @relation(fields: [consentId], references: [id])

    @@map("user_consents")
    @@schema("moderation")
}

enum CONSENT_TYPE {
    TERMS_OF_SERVICE
    PRIVACY_POLICY
    MEDICAL_DATA_PROCESSING
    MARKETING

    @@schema("moderation")
}

enum MODERATION_STATUS {
    PENDING
    APPROVED
    REJECTED
    BANNED

    @@schema("moderation")
}

enum TICKET_STATUS {
    OPEN
    IN_PROGRESS
    RESOLVED
    CLOSED

    @@schema("moderation")
}
