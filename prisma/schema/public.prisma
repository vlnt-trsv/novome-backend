model User {
    id                String            @id @default(uuid()) @db.Uuid
    email             String            @unique
    phone             String?           @unique
    role              ROLE
    fullName          String
    avatar            String?
    language          String            @default("ru")
    timezone          String            @default("Asia/Novosibirsk")
    leadSource        String? // Откуда пришел пользователь (для аналитики)
    createdAt         DateTime          @default(now())
    updatedAt         DateTime          @updatedAt
    notifications     Notification[]
    userConsents      UserConsent[]
    status            MODERATION_STATUS @default(APPROVED)
    moderationComment String?           @db.Text
    tickets           Ticket[]
    patient           Patient?          @relation("Patient")
    doctor            Doctor?           @relation("Doctor")
    clinic            Clinic?           @relation("Clinic")
    auth              Auth              @relation("UserAuth", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)
    aiToken           Int               @default(10)

    @@index([status])
    @@index([email, phone])
    @@map("users")
    @@schema("public")
}

model Patient {
    id              String        @unique @db.Uuid
    birthdate       DateTime?
    gender          GENDER?
    medicalNotes    String?       @db.Text
    bloodType       String? // Например: "A+", "B-"
    allergies       String[]      @default([])
    chronicDiseases String?       @db.Text
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt
    appointments    Appointment[]
    favorites       Favorite[]
    documents       File[]
    reviews         Review[]
    user            User          @relation("Patient", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)

    @@map("patients")
    @@schema("public")
}

model Doctor {
    id                 String           @unique @db.Uuid
    gender             GENDER?
    birthdate          DateTime?
    experience         Int
    specializations    SPECIALIZATION[]
    education          String
    workplace          String?
    bio                String?          @db.Text
    isActive           Boolean          @default(true) // Работает ли врач в системе
    isSearchable       Boolean          @default(true) // Виден ли в поиске (скрываем, если в отпуске)
    inn                String           @unique
    license            String           @unique
    createdAt          DateTime         @default(now())
    updatedAt          DateTime         @updatedAt
    rating             Float            @default(0.0)
    relationships      Relationship[]
    appointments       Appointment[]
    documents          File[]
    favoriteByPatients Favorite[]
    schedules          Schedule[]
    timeSlots          TimeSlot[]
    workRules          WorkRule[]
    services           Service[]
    breaks             Break[]
    reviews            Review[]
    user               User             @relation("Doctor", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)

    @@map("doctors")
    @@schema("public")
}

model Clinic {
    id                 String         @unique @db.Uuid
    legalName          String
    brandName          String?
    inn                String         @unique
    ogrn               String
    license            String
    directorName       String
    directorPosition   String
    legalAddress       String
    actualAddress      String
    city               String?
    phone              String?
    website            String?
    description        String?        @db.Text
    isActive           Boolean        @default(true)
    createdAt          DateTime       @default(now())
    updatedAt          DateTime       @updatedAt
    rating             Float          @default(0.0)
    relationships      Relationship[]
    appointments       Appointment[]
    favoriteByPatients Favorite[]
    documents          File[]
    schedules          Schedule[]
    timeSlots          TimeSlot[]
    services           Service[]
    reviews            Review[]
    user               User           @relation("Clinic", fields: [id], references: [id], onUpdate: Cascade, onDelete: Cascade)

    @@index([city])
    @@map("clinics")
    @@schema("public")
}

model Favorite {
    id       String   @id @default(uuid()) @db.Uuid
    userId   String   @db.Uuid
    doctorId String?  @db.Uuid
    clinicId String?  @db.Uuid
    addedAt  DateTime @default(now())
    patient  Patient  @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
    doctor   Doctor?  @relation(fields: [doctorId], references: [id], onUpdate: Cascade, onDelete: Cascade)
    clinic   Clinic?  @relation(fields: [clinicId], references: [id], onUpdate: Cascade, onDelete: Cascade)

    @@unique([userId, doctorId])
    @@unique([userId, clinicId])
    @@index([userId])
    @@index([doctorId])
    @@map("favorites")
    @@schema("public")
}

model Service {
    id             String           @id @default(uuid()) @db.Uuid
    title          String
    description    String?          @db.Text
    specialization SPECIALIZATION
    category       SERVICE_CATEGORY
    price          Decimal?         @db.Decimal(10, 2)
    isActive       Boolean          @default(true)
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt
    clinicId       String?          @db.Uuid
    doctorId       String?          @db.Uuid
    archive        ServiceArchive?
    clinic         Clinic?          @relation(fields: [clinicId], references: [id])
    doctor         Doctor?          @relation(fields: [doctorId], references: [id])

    @@index([clinicId])
    @@index([doctorId])
    @@index([clinicId, specialization])
    @@map("services")
    @@schema("public")
}

model Rating {
    id        String   @id @default(uuid()) @db.Uuid
    patientId String   @db.Uuid
    value     Float    @default(0.0)
    doctorId  String?  @db.Uuid
    clinicId  String?  @db.Uuid
    reviewId  String?  @unique @db.Uuid
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    review    Review?  @relation(fields: [reviewId], references: [id])

    @@unique([patientId, doctorId])
    @@unique([patientId, clinicId])
    @@map("ratings")
    @@schema("public")
}

model Notification {
    id          String            @id @default(uuid()) @db.Uuid
    userId      String            @db.Uuid
    type        NOTIFICATION_TYPE
    title       String
    description String            @db.Text
    isRead      Boolean           @default(false)
    payload     Json?             @db.JsonB
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt
    user        User              @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

    @@index([userId, isRead])
    @@map("notifications")
    @@schema("public")
}

model Relationship {
    id        String               @id @default(uuid()) @db.Uuid
    doctorId  String               @db.Uuid
    clinicId  String               @db.Uuid
    status    RELATIONSHIP_STATUS  @default(PENDING)
    createdAt DateTime             @default(now())
    updatedAt DateTime             @updatedAt
    archive   RelationshipArchive?
    clinic    Clinic               @relation(fields: [clinicId], references: [id])
    doctor    Doctor               @relation(fields: [doctorId], references: [id])

    @@unique([doctorId, clinicId])
    @@map("relationships")
    @@schema("public")
}

model Review {
    id           String        @id @default(uuid()) @db.Uuid
    patientId    String        @db.Uuid
    doctorId     String?       @db.Uuid
    clinicId     String?       @db.Uuid
    moderationId String?       @db.Uuid
    rating       Rating?
    text         String        @db.Text
    status       REVIEW_STATUS @default(PENDING)
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt
    clinic       Clinic?       @relation(fields: [clinicId], references: [id])
    doctor       Doctor?       @relation(fields: [doctorId], references: [id])
    patient      Patient       @relation(fields: [patientId], references: [id])
    moderation   Moderation?   @relation(fields: [moderationId], references: [id])

    @@index([patientId])
    @@index([doctorId])
    @@index([clinicId])
    @@map("reviews")
    @@schema("public")
}

enum REVIEW_STATUS {
    APPROVED
    PENDING
    REJECTED
    ARCHIVED

    @@schema("moderation")
}

enum RELATIONSHIP_STATUS {
    APPROVED
    PENDING
    REJECTED
    ARCHIVED

    @@schema("public")
}

enum NOTIFICATION_TYPE {
    RELATIONSHIP_MESSAGE
    APPOINTMENT_MESSAGE
    SYSTEM_MESSAGE

    @@schema("public")
}

enum ROLE {
    PATIENT
    DOCTOR
    CLINIC

    @@schema("public")
}

enum GENDER {
    MALE
    FEMALE

    @@schema("public")
}

enum SERVICE_CATEGORY {
    CONSULTATION // Консультации (первичные, повторные, онлайн)
    DIAGNOSTICS // Диагностика (УЗИ, анализы перед операцией, 3D-моделирование)
    SURGERY_FACE // Хирургия лица (рино, блефаро, фейслифт)
    SURGERY_BODY // Хирургия тела (маммопластика, абдоминопластика)
    SURGERY_RECONSTRUCTIVE // Реконструктивная и микрохирургия
    COSMETOLOGY_INJECTABLE // Инъекционная косметология (филлеры, ботокс)
    COSMETOLOGY_HARDWARE // Аппаратная косметология (лазер, SMAS)
    AESTHETIC_MEDICINE // Эстетические процедуры (пилинги, уходы)
    REHABILITATION // Реабилитация (послеоперационный уход, перевязки)
    ANALYSIS // Лабораторные исследования
    OTHER // Прочее

    @@schema("public")
}

enum SPECIALIZATION {
    // Эстетическая хирургия лица
    RHINOPLASTY // Ринопластика (пластика носа)
    BLEPHAROPLASTY // Блефаропластика (пластика век)
    FACELIFT // Фейслифтинг (подтяжка лица)
    FRONTLIFTING // Подтяжка лба
    MALARPLASTY // Увеличение скул
    MENTOPLASTY // Увеличение подбородка
    OTOPLASTY // Отопластика (пластика ушей)
    CHEILOPLASTY // Увеличение губ
    NECK_LIFT // Подтяжка шеи

    // Эстетическая хирургия тела
    MAMMOPLASTY // Маммопластика (пластика груди)
    LIPOSUCTION // Липосакция
    ABDOMINOPLASTY // Абдоминопластика (пластика живота)
    GLUTEOPLASTY // Увеличение ягодиц
    BRACHIOPLASTY // Подтяжка кожи рук

    // Реконструктивная хирургия
    BURN_RECONSTRUCTION // Реконструкция после ожогов
    TRAUMA_RECONSTRUCTION // Реконструкция после травм
    CANCER_RECONSTRUCTION // Реконструкция после онкологии
    CLEFT_LIP_PALATE // Расщелина губы и неба
    CONGENITAL_DEFORMITIES // Врожденные деформации

    // Микрохирургия
    MICROSURGERY // Микрохирургия
    TISSUE_TRANSPLANTATION // Пересадка тканей
    FLAP_SURGERY // Хирургия лоскутов

    // Хирургия кисти
    HAND_SURGERY // Хирургия кисти
    HAND_RECONSTRUCTION // Реконструкция кисти
    TENDON_REPAIR // Восстановление сухожилий

    // Челюстно-лицевая хирургия
    MAXILLOFACIAL_SURGERY // Челюстно-лицевая хирургия
    JAW_CORRECTION // Коррекция челюсти
    FACIAL_FRACTURE // Переломы лица

    // Дерматология и косметология
    DERMABRASION // Дермабразия
    CHEMICAL_PEEL // Химический пилинг
    LASER_SURGERY // Лазерная хирургия
    SCAR_REVISION // Коррекция рубцов

    // Генитальная пластическая хирургия
    LABIAPLASTY // Лабиопластика
    VAGINOPLASTY // Вагинопластика
    PENILE_AUGMENTATION // Увеличение полового члена

    // Общая пластическая хирургия
    GENERAL_PLASTIC_SURGERY // Общая пластическая хирургия
    COSMETIC_SURGERY // Косметическая хирургия
    RECONSTRUCTIVE_SURGERY // Реконструктивная хирургия

    @@schema("public")
}
